{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "http://185.199.53.201:5001/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://185.199.53.201:5001/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "http://185.199.53.201:5001/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
